# Copy to .env and fill in. .env is git-ignored; never commit real values.
ENV=local
DATABASE_URL=postgresql://ukco:ukco@localhost:5432/ukco

# Free key: https://developer.company-information.service.gov.uk/ → register → create application → REST API key
COMPANIES_HOUSE_API_KEY=

# Optional: enables the LLM-written summary and flag explanations in reports.
# https://platform.claude.com → API keys
ANTHROPIC_API_KEY=

# Optional: tracing via OpenTelemetry → Langfuse (cloud.langfuse.com → project → API keys).
# Or set OTEL_EXPORTER_OTLP_ENDPOINT for any OTLP collector.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# LANGFUSE_HOST=https://cloud.langfuse.com
# Export prompt/completion content to traces (they include officer names). Off by default.
# TRACE_CONTENT=false
