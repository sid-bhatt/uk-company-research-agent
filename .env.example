# Copy to .env and fill in. .env is git-ignored; never commit real values.
ENV=local
DATABASE_URL=postgresql://ukco:ukco@localhost:5432/ukco

# Free key: https://developer.company-information.service.gov.uk/ → register → create application → REST API key
COMPANIES_HOUSE_API_KEY=

# Optional: the LLM-written summary and flag explanations, and the report chat
# ("why is this flagged?"). Both are off without a key.
# Free: a Google Gemini key from https://aistudio.google.com/apikey (no card needed).
# Any OpenAI-compatible API works: e.g. Groq is
#   LLM_BASE_URL=https://api.groq.com/openai/v1  LLM_MODEL=llama-3.3-70b-versatile
LLM_API_KEY=
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# LLM_MODEL=gemini-3.5-flash
# Or Claude (paid, https://platform.claude.com → API keys); used only when LLM_API_KEY is empty.
ANTHROPIC_API_KEY=
# CHAT_EFFORT=medium
# CHAT_DAILY_QUESTIONS=50
# Daily limits (UTC): REPORTS_DAILY_PER_USER=20, REPORTS_DAILY_TOTAL=200, CHAT_DAILY_TOTAL=500

# Optional: tracing via OpenTelemetry → Langfuse (cloud.langfuse.com → project → API keys).
# Or set OTEL_EXPORTER_OTLP_ENDPOINT for any OTLP collector.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# LANGFUSE_HOST=https://cloud.langfuse.com
# Export prompt/completion content to traces (they include officer names). Off by default.
# TRACE_CONTENT=false
