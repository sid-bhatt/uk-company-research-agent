# Copy to .env.local. Never commit real values.
API_URL=http://localhost:8000

# Signs the session cookie: `openssl rand -base64 32`
AUTH_SECRET=

# Shared with the API (API_JWT_SECRET in the root .env). When set, the API requires the
# web app's signed tokens; leave unset locally to use the X-User fallback.
API_JWT_SECRET=

# GitHub sign-in: github.com/settings/developers → New OAuth App,
# callback URL http://localhost:3000/api/auth/callback/github
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
# Comma-separated GitHub logins allowed to sign in (empty = anyone with GitHub)
AUTH_ALLOWED_USERS=

# Local-only "dev login" (no password) when GitHub isn't configured. Never in production.
AUTH_DEV_LOGIN=true
