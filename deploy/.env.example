# Production settings for deploy/compose.yml. On AWS these come from SSM Parameter Store
# (written to deploy/.env on the server by the deploy job); never commit real values.
# Docker env files don't support inline comments: keep comments on their own lines.
ENV=production
# A domain you own, or <elastic-ip-with-dashes>.sslip.io
API_HOST=api.example.com
API_IMAGE=ukco-api:dev
POSTGRES_PASSWORD=change-me
COMPANIES_HOUSE_API_KEY=
# At least 32 characters; the same value goes in Vercel.
API_JWT_SECRET=
# Optional: enables report summaries and chat (free Gemini key, or any OpenAI-compatible API).
LLM_API_KEY=
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# LLM_MODEL=gemini-3.5-flash
# Or Claude, used only when LLM_API_KEY is empty.
ANTHROPIC_API_KEY=
GIT_SHA=dev
